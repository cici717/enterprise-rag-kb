# LLM 配置
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Embedding 配置: hashing 或 openai
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=384

# 检索参数
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# 数据库
DATABASE_URL=sqlite:///./data/rag.db